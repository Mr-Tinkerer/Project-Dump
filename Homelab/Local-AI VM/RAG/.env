EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://host.containers.internal:9932/v1
EMBEDDING_BINDING_API_KEY=none
EMBEDDING_MODEL=Qwen3-Embedding-0.6B-f16
EMBEDDING_DIM=1024

LLM_BINDING=openai
LLM_BINDING_HOST=http://host.containers.internal:9933/v1
LLM_BINDING_API_KEY=none
LLM_MODEL=Qwen3.5-4B-Q4_K_M

VLM_PROCESS_ENABLE=true
VLM_LLM_BINDING=openai
VLM_LLM_BINDING_HOST=http://host.containers.internal:9931/v1
VLM_LLM_MODEL=Qwen2.5-VL-3B-Instruct
VLM_LLM_BINDING_API_KEY=none
VLM_MAX_ASYNC_LLM=1

DOCLING_ENDPOINT=http://docling:5001
MAX_PARALLEL_PARSE_DOCLING=1

LIGHTRAG_PARSER=png:docling-iP!,jpg:docling-iP!,jpeg:docling-iP!,*:native-iP,*:docling-iP,*:legacy-R
MAX_ASYNC_LLM=1
MAX_PARALLEL_INSERT=1
MAX_EXTRACT_INPUT_TOKENS=8000
OPENAI_LLM_MAX_TOKENS=5120
OPENAI_LLM_MAX_COMPLETION_TOKENS=5120
MAX_TOTAL_TOKENS=10000
SUMMARY_CONTEXT_SIZE=10000

ENTITY_EXTRACTION_USE_JSON=true
ENABLE_ENTITY_AUTO_MERGE=true
DOCLING_OCR_PRESET=tesseract
DOCLING_OCR_LANG=eng

LLM_TIMEOUT=9999
EXTRACT_LLM_TIMEOUT=9999
VLM_LLM_TIMEOUT=9999
EMBEDDING_TIMEOUT=9999
TIMEOUT=9999
