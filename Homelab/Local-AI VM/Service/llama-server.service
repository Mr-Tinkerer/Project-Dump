[Unit]
Description=Llama.cpp router

[Service]
WorkingDirectory=/opt/llama.cpp/build/bin
ExecStart=llama-server --host 127.0.0.1,10.10.0.5 --port 9931 --no-ui --sleep-idle-seconds 300 --models-max 2 --models-preset /home/ai/presets.ini --api-key ""
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
