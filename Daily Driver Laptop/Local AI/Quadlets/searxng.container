[Unit]
Description=Private Search Engine

[Container]
Image=ghcr.io/searxng/searxng
ContainerName=searxng
Volume=%h/Projects/LLMs/searxng/config/:/etc/searxng:Z
Volume=%h/Projects/LLMs/searxng/data/:/var/cache/searxng:Z
PublishPort=8888:8080

[Service]
Restart=always

[Unit]
PartOf=chat.target

[Install]
WantedBy=chat.target
